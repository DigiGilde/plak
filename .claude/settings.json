{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr create *)",
            "command": "uv run --quiet --script \"${CLAUDE_PROJECT_DIR}/scripts/release.py\" hook",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
