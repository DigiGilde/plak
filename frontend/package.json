    "@vue/test-utils": "^2.5.1",
    "axe-core": "^4.13.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.11"
