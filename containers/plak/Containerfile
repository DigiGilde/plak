# syntax=docker/dockerfile:1
# Builds the whole product image: backend plus the built admin SPA. Build
# context is the repo root (dev/compose.yml: context ".."), because the
# image bundles the built admin SPA from frontend/ alongside the backend.
FROM docker.io/library/node:24-trixie-slim@sha256:43b9ba1142b8dcf33fa8f922ca1be85714adc444e0586c7cf7726daaeabc1bea AS spa

WORKDIR /spa

COPY frontend/package.json frontend/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --no-audit --no-fund

ARG PLAK_VERSION=dev
COPY frontend/ ./
RUN PLAK_VERSION="${PLAK_VERSION}" npm run build

FROM ghcr.io/astral-sh/uv:0.13-python3.15-trixie-slim@sha256:86a05dd8f19b21368fbb160c7e2ad0576780bebbe89114b6deeba2506f7612e1 AS build

WORKDIR /app

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

COPY backend/pyproject.toml backend/uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv uv sync --frozen --no-dev --no-install-project

COPY backend/src ./src
RUN --mount=type=cache,target=/root/.cache/uv uv sync --frozen --no-dev

FROM docker.io/library/python:3.15-slim-trixie@sha256:533b0b2f9b5d46fd097091cf826f27902f1d6c3bca714b6dc74551356aa97a51 AS runtime

# The app runs from the venv uv built, so pip is not needed here, and pip
# 26.2.2 vendors urllib3, msgpack and setuptools with HIGH advisories. The CI
# scan of this base image skips pip's directory to match (ci.yml).
RUN python -m pip uninstall --yes --quiet pip

RUN groupadd --system --gid 1000 plak \
    && useradd --system --uid 1000 --gid plak --no-create-home plak \
    # /content/_tmp pre-created in the image: rootless Podman chowns an EMPTY
    # named volume on every container start to that image's mountpoint owner.
    # Copy-up of this non-empty directory on the first app mount keeps the
    # volume non-empty and thus owned by plak.
    && mkdir -p /content/_tmp \
    && chown -R plak:plak /content

WORKDIR /app

COPY --from=build --chown=plak:plak /app/.venv /app/.venv
COPY --from=build --chown=plak:plak /app/src /app/src
COPY --from=spa --chown=plak:plak /spa/dist /app/spa
COPY --chown=plak:plak backend/alembic ./alembic
COPY --chown=plak:plak backend/alembic.ini ./alembic.ini
# 555, not 755: the file is read and executed, never written, and the user
# that runs it does not own it.
COPY --chown=plak:plak --chmod=555 containers/plak/entrypoint.sh ./entrypoint.sh

ARG PLAK_VERSION=dev
ENV PATH="/app/.venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    PLAK_SPA_PATH=/app/spa \
    PLAK_VERSION=${PLAK_VERSION}

# Numeric: the kubelet cannot verify runAsNonRoot for a user name.
USER 1000:1000

EXPOSE 8080

# The entrypoint migrates and then execs uvicorn; the --no-access-log that
# keeps secret links (?key=...) out of the log stack lives there now
# (docs/security.md).
CMD ["./entrypoint.sh"]
