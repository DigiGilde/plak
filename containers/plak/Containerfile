# syntax=docker/dockerfile:1
# Builds the whole product image: backend plus the built admin SPA. Build
# context is the repo root (dev/compose.yml: context ".."), because the
# image bundles the built admin SPA from frontend/ alongside the backend.
# docker.io/library/node:22-bookworm-slim
FROM docker.io/library/node@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c AS spa

WORKDIR /spa

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY frontend/ ./
RUN npm run build

# ghcr.io/astral-sh/uv:0.5-python3.12-bookworm-slim
FROM ghcr.io/astral-sh/uv@sha256:fef6dca3a45cd7ac8c4386e78263033ee4b262fe36c1ee077630e53ed6df2070 AS build

WORKDIR /app

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY backend/src ./src
RUN uv sync --frozen --no-dev

# docker.io/library/python:3.12-slim-bookworm
FROM docker.io/library/python@sha256:392307d22300de8b5986851a12d9176dfc0fc073e65bf6523ebd7dcbeb23564e AS runtime

RUN groupadd --system --gid 1000 plak \
    && useradd --system --uid 1000 --gid plak --no-create-home plak \
    # /content/_tmp pre-created in the image: rootless Podman chowns an EMPTY
    # named volume on every container start to that image's mountpoint owner.
    # Copy-up of this non-empty directory on the first app mount keeps the
    # volume non-empty and thus owned by plak.
    && mkdir -p /content/_tmp \
    && chown -R plak:plak /content

WORKDIR /app

COPY --from=build --chown=plak:plak /app/.venv /app/.venv
COPY --from=build --chown=plak:plak /app/src /app/src
COPY --from=spa --chown=plak:plak /spa/dist /app/spa
COPY --chown=plak:plak backend/alembic ./alembic
COPY --chown=plak:plak backend/alembic.ini ./alembic.ini

ENV PATH="/app/.venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    PLAK_SPA_PATH=/app/spa

USER plak

EXPOSE 8080

# --no-access-log: uvicorn's access log logs path plus querystring and would
# write every secret link (?key=...) in plain text to stdout and the log
# stack; the audit log and app logging remain (docs/security.md).
CMD ["uvicorn", "plak.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8080", "--no-access-log"]
