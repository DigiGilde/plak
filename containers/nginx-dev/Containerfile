FROM docker.io/nginxinc/nginx-unprivileged:1.31-alpine-slim@sha256:a8cb0f33d51fa107c96fd2bd3a71aaf564ec131e9d2bdf8700944f0ed8b170d7

COPY nginx.conf /etc/nginx/nginx.conf
COPY --chmod=0755 10-resolver.sh /docker-entrypoint.d/10-resolver.sh

# 10-resolver.sh writes the resolver at startup; /etc/nginx is not writable
# for the nginx user, so the real file lives on /tmp.
USER root
RUN ln -s /tmp/resolver.conf /etc/nginx/resolver.conf
USER nginx

EXPOSE 8080
